# =============================================================================
#  Minecraft Server Manager — configuration
#  Copier en `.env` puis adapter.  Ne JAMAIS committer le fichier `.env`.
#  Sous Linux : chmod 600 .env
# =============================================================================

# --- Réseau ---------------------------------------------------------------
MSM_HOST=127.0.0.1
MSM_PORT=8000

# Origines autorisées pour le frontend (séparées par des virgules).
MSM_CORS_ORIGINS=http://localhost:5173

# --- Sécurité -------------------------------------------------------------
# OBLIGATOIRE en production. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changer cette valeur invalide toutes les sessions et rend illisibles les
# secrets chiffrés en base (mots de passe RCON).
MSM_SECRET_KEY=

# Durée de vie d'une session (heures) et cookie sécurisé.
MSM_SESSION_TTL_HOURS=168
MSM_SESSION_COOKIE_SECURE=false

# --- Base de données ------------------------------------------------------
# SQLite par défaut ; PostgreSQL : postgresql+asyncpg://user:pass@host/msm
MSM_DATABASE_URL=sqlite+aiosqlite:///./data/msm.db

# --- Chemins --------------------------------------------------------------
MSM_DATA_DIR=./data
MSM_LOG_DIR=./logs

# Racines autorisées pour les dossiers de serveurs Minecraft (séparées par
# `;` sous Windows, `:` sous Linux). Vide = aucune restriction (déconseillé).
MSM_SERVER_ROOTS=

# --- Processus Minecraft --------------------------------------------------
MSM_DEFAULT_STOP_TIMEOUT_S=60
MSM_DEFAULT_KILL_TIMEOUT_S=15
MSM_DEFAULT_START_TIMEOUT_S=300
MSM_DEFAULT_LOG_HISTORY_LINES=5000

# --- Uploads --------------------------------------------------------------
MSM_UPLOAD_MAX_SIZE_MB=256

# --- Journalisation MSM ---------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
MSM_LOG_LEVEL=INFO
# console | json
MSM_LOG_FORMAT=console
MSM_LOG_RETENTION_DAYS=30
