[Unit]
Description=Minecraft Server Manager
Documentation=https://github.com/R3coNYT/Minecraft_Server_Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=__MSM_USER__
Group=__MSM_GROUP__
WorkingDirectory=__MSM_HOME__
EnvironmentFile=__MSM_CONFIG__/.env
ExecStart=__MSM_HOME__/backend/.venv/bin/python -m msm.cli serve

# Restarts the panel only: the Minecraft servers outlive it and are re-adopted
# at the next start.
Restart=on-failure
RestartSec=5s

# Generous stop timeout: MSM does not stop the Minecraft servers, but lets its
# database writes finish cleanly.
TimeoutStopSec=30s
# Only MSM is stopped. The Minecraft servers belong to the same control group:
# with `mixed` or `control-group`, systemd would kill them (SIGKILL, without
# saving the world) on every restart or update of the panel. This way they
# outlive it, and are re-adopted at the next start. systemd will report these
# "left-over" processes on restart: that is expected.
KillMode=process

# --- Hardening --------------------------------------------------------------
# MSM launches Java processes that must write to the server folders: the
# restrictions are therefore calibrated, not maximal. Each line removed would
# widen the attack surface if the panel were compromised.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# Only these paths are writable. `__MSM_SERVERS__` holds the Minecraft server
# folders; adjust it if your servers live elsewhere.
ReadWritePaths=__MSM_DATA__ __MSM_LOGS__ __MSM_SERVERS__

# Logging: MSM also writes to its own file, but journald keeps track of starts
# and failures.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=msm

[Install]
WantedBy=multi-user.target
